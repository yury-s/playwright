{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "strict": true,
    "module": "ESNext",
    "rootDir": "..",
    "outDir": "./dist/lib",
    "resolveJsonModule": true,
    "types": ["chrome", "node"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
  ],
  "exclude": [
    "src/ui",
  ]
}
